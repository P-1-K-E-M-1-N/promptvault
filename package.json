{
  "name": "promptvault",
  "version": "0.1.0",
  "description": "Every prompt you've ever written to an AI, searchable in one place. Runs on your machine. Nothing uploaded.",
  "type": "module",
  "bin": {
    "promptvault": "bin/promptvault.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/promptvault.js",
    "test": "node --test \"test/*.test.js\"",
    "demo": "node bin/promptvault.js --db ./.demo/demo.db --claude-dir ./test/fixtures/claude-code --import ./test/fixtures/chatgpt/conversations.json --import ./test/fixtures/claude-export/conversations.json --import ./test/fixtures/gemini/MyActivity.json"
  },
  "engines": {
    "node": "^22.23.0 || >=24.0.0"
  },
  "keywords": [
    "claude-code",
    "chatgpt",
    "gemini",
    "prompts",
    "search",
    "local-first",
    "sqlite",
    "fts5",
    "cli",
    "ai-history"
  ],
  "author": "Nickel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-1-K-E-M-1-N/promptvault.git"
  },
  "bugs": {
    "url": "https://github.com/P-1-K-E-M-1-N/promptvault/issues"
  },
  "homepage": "https://github.com/P-1-K-E-M-1-N/promptvault#readme",
  "dependencies": {}
}
